    "/seekbox-config/api/analytics/accounts": {
      "get": {
        "description": "支持from/to RFC3339左闭右开、Asia/Shanghai、provider、app_version、installation_id等；详情筛选及分页见协议。搜索/转存扩展指标尚未启用，明确返回METRIC_NOT_SUPPORTED。",
        "operationId": "GET /seekbox-config/api/analytics/accounts",
        "parameters": [
          {
            "description": "只支持Asia/Shanghai",
            "in": "query",
            "name": "timezone",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "按匿名实例筛选",
            "in": "query",
            "name": "installation_id",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "运行按当前快照版本、run按执行版本、留存按首次登记版本",
            "in": "query",
            "name": "app_version",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "baidu/quark/xunlei；运行留存不支持此筛选",
            "in": "query",
            "name": "provider",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "1–100，默认20",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "上一页next_cursor；保持筛选不变；新记录以as_of限制，当前快照可更新",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "统一code/message/request_id/data响应"
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "凭证无效"
          },
          "403": {
            "description": "无操作权限"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "adminSession": []
          }
        ],
        "summary": "统计与运行明细"
      }
    },
