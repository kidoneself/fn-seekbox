{
  "components": {
    "securitySchemes": {
      "adminSession": {
        "in": "cookie",
        "name": "seekbox_config_session",
        "type": "apiKey"
      },
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "小白搜盘管理服务",
    "version": "1.1"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/check-link": {
      "get": {
        "description": "provider 必填且只能出现一次：baidu / quark / xunlei。未配置404、停用/到期503；每次读取最新配置。",
        "operationId": "GET /api/check-link",
        "parameters": [
          {
            "description": "baidu / quark / xunlei；只允许一个值",
            "in": "query",
            "name": "provider",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "统一code/message/request_id/data响应"
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "凭证无效"
          },
          "403": {
            "description": "无操作权限"
          }
        },
        "summary": "获取网盘测试源"
      }
    },
    "/api/client/config": {
      "get": {
        "description": "Bearer使用登记返回的report_token。配置版本变化后客户端更新上报间隔和批次限制。检查仍由客户端在北京时间00:00执行；服务端不操作网盘。",
        "operationId": "GET /api/client/config",
        "responses": {
          "200": {
            "description": "统一code/message/request_id/data响应"
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "凭证无效"
          },
          "403": {
            "description": "无操作权限"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "/api/client/config"
      }
    },
    "/api/client/events/batch": {
      "post": {
        "description": "四类account_check事件。started: run_id/account_ref/provider/trigger/scheduled_for/attempt；stage_finished: run_id/stage/status/duration_ms/error_code；finished: 完整身份、source_id/source_version/auth_status/result/failed_stage/error_code/duration_ms/cleanup_pending/deletion_mode及7阶段stages；cleanup_finished: run_id/result/duration_ms/error_code/deletion_mode。完整字段、枚举和实际闭环计次规则见随包 requirements-v1.1.md 第9节。去重按实例+event_id；同run终态换ID仍只计一次。最多补报7天，未来超过5分钟拒收；按条accepted/duplicate/rejected，应只重试未确认或retryable=true项目。",
        "operationId": "POST /api/client/events/batch",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "batch_id": "<随机ID>",
                "events": [],
                "schema_version": 1
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "统一code/message/request_id/data响应"
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "凭证无效"
          },
          "403": {
            "description": "无操作权限"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "批量上报检查事件"
      }
    },
    "/api/client/heartbeat": {
      "post": {
        "description": "真实接口；字段与协议详见随包 requirements-v1.1.md。所有响应带 request_id；错误 data=null。",
        "operationId": "POST /api/client/heartbeat",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "accounts": [],
                "accounts_complete": true,
                "active_jobs": 0,
                "app_version": "1.5.13",
                "arch": "amd64",
                "platform": "fnos",
                "reported_at": "<RFC3339>",
                "schema_version": 1,
                "snapshot_seq": 1,
                "subscriptions": {
                  "enabled": 0,
                  "total": 0
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "统一code/message/request_id/data响应"
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "凭证无效"
          },
          "403": {
            "description": "无操作权限"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "上报运行快照"
      }
    },
    "/api/client/register": {
      "post": {
        "description": "真实接口；字段与协议详见随包 requirements-v1.1.md。所有响应带 request_id；错误 data=null。",
        "operationId": "POST /api/client/register",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "app_version": "1.5.13",
                "arch": "amd64",
                "client_instance_id": "<持久随机UUID>",
                "platform": "fnos",
                "registration_nonce": "<至少32随机字节的base64url>",
                "schema_version": 1
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "统一code/message/request_id/data响应"
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "凭证无效"
          },
          "403": {
            "description": "无操作权限"
          }
        },
        "summary": "登记匿名安装实例"
      }
    },
    "/api/search-sites": {
      "get": {
        "description": "包括停用记录，按 order、id 升序；网址仅为配置，不自动新增搜索插件。",
        "operationId": "GET /api/search-sites",
        "responses": {
          "200": {
            "description": "统一code/message/request_id/data响应"
