appname               = fn-seekbox
version               = 1.2.0
display_name          = 小白搜盘
desc                  = <p><strong>一个入口，搜索多个网盘来源。</strong>小白搜盘是专为飞牛 fnOS 打造的资源聚合搜索应用。输入影视、软件或学习资料名称，即可同时查询多个搜索来源，减少在不同网站之间反复切换的麻烦。</p><p>应用内置 26 个可配置搜索插件，自动汇总结果，并按百度网盘、阿里云盘、夸克网盘、天翼云盘、UC网盘、115、迅雷云盘、123云盘、磁力等类型分类展示。支持搜索来源开关、连通与试搜检测、结果链接检测以及 JSON / TXT 批量导出。</p><p>以 fnOS 原生 FPK 形式安装，无需 Docker；同时适配桌面小窗口和独立浏览器。应用接入 fnOS 统一网关鉴权，复用 NAS 登录状态，不额外暴露 Web 端口，并以独立应用用户运行。</p>
platform              = x86
source                = thirdparty
maintainer            = kidoneself
maintainer_url        = https://github.com/kidoneself/fn-seekbox
distributor           = kidoneself
distributor_url       = https://github.com/kidoneself/fn-seekbox
os_min_version        = 1.1.8
desktop_uidir         = ui
desktop_applaunchname = fn-seekbox.main
ctl_stop              = true
changelog             = 全面重做产品界面与信息层级；浏览器版和 fnOS 小窗口分别适配；设置改为侧边抽屉；优化结果来源、提取码及打开/复制操作；新增快捷键；移除旧独立登录并修复残留令牌冲突。
