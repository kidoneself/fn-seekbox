#!/bin/bash
# 小白搜盘：后端二进制 + Python 网关（静态页 + 只走插件搜索）

LOG_FILE="${TRIM_PKGVAR}/info.log"
BACKEND_LOG="${TRIM_PKGVAR}/data/logs/backend/seekbox.log"
GATEWAY_LOG="${TRIM_PKGVAR}/data/logs/gateway.log"
BACKEND_PID_FILE="${TRIM_PKGVAR}/seekbox.pid"
GATEWAY_PID_FILE="${TRIM_PKGVAR}/gateway.pid"

BIN="${TRIM_APPDEST}/bin/seekbox"
GATEWAY="${TRIM_APPDEST}/bin/gateway.py"
WEBROOT="${TRIM_APPDEST}/web"
GATEWAY_SOCKET="${TRIM_APPDEST}/app.sock"
GATEWAY_PREFIX="/app/fn-seekbox"

BACKEND_HOST="127.0.0.1"
BACKEND_PORT="18888"

# 飞牛向导空字符串不会用镜像默认值；bash 的 :- 会。保留原有 26 个来源，并新增 17 个 NAS 直连试搜通过的来源。
DEFAULT_PLUGINS="ikantv,dyyjpro,duoduo,feikuai,gaoqing888,gying,hunhepan,jutoushe,kkv,lingjisp,lou1,melost,ouge,panlian,qqpd,quark4k,quarksoo,quarktv,sousou,thepiratebay,wanou,weibo,xb6v,xiaozhang,yunso,zxzj,aipan,clmao,clxiong,diduan,dygang,erxiaopan,hjzhencai,huban,leso,libvio,meitizy,miosou,muou,shandian,xiaokupan,xiaoyu,zhizhen"

log_msg() {
    mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

check_pid() {
    local pid="$1"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

status() {
    local gpid bpid
    gpid=$(cat "$GATEWAY_PID_FILE" 2>/dev/null || true)
    bpid=$(cat "$BACKEND_PID_FILE" 2>/dev/null || true)
    if check_pid "$gpid" && check_pid "$bpid"; then
        return 0
    fi
    return 1
}

export_runtime_env() {
    # fnOS can start package scripts without an exported PATH. Include the
    # declared Node.js dependency so Go and the login helper resolve it too.
    export PATH="/var/apps/nodejs_v22/target/bin:${PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}"
    if [ -z "${ENABLED_PLUGINS}" ]; then
        ENABLED_PLUGINS="${DEFAULT_PLUGINS}"
    fi
    export ENABLED_PLUGINS
    export PORT="${BACKEND_PORT}"
    export BACKEND_HOST BACKEND_PORT
    export PANSOU_HOST="${BACKEND_HOST}" PANSOU_PORT="${BACKEND_PORT}"
    export CACHE_PATH="${TRIM_PKGVAR}/data/cache"
    export CACHE_ENABLED="${CACHE_ENABLED:-true}"
    export CACHE_TTL="${CACHE_TTL:-60}"
    export MAX_CONCURRENCY="${MAX_CONCURRENCY:-200}"
    export MAX_PAGES="${MAX_PAGES:-30}"
    export ASYNC_PLUGIN_ENABLED="${ASYNC_PLUGIN_ENABLED:-true}"
    export PROXY
    export TZ="${TZ:-Asia/Shanghai}"
    export WEBROOT GATEWAY_SOCKET GATEWAY_PREFIX
}

wait_gateway_ready() {
    local gateway_pid="$1" backend_pid="$2"
    local deadline=$((SECONDS + 30)) remaining probe_timeout
    while [ "$SECONDS" -lt "$deadline" ]; do
        if ! check_pid "$gateway_pid" || ! check_pid "$backend_pid"; then
            return 2
        fi
        if [ -S "$GATEWAY_SOCKET" ]; then
            remaining=$((deadline - SECONDS))
            [ "$remaining" -le 0 ] && break
            probe_timeout=2
            [ "$remaining" -lt "$probe_timeout" ] && probe_timeout="$remaining"
            # A socket can exist before Python begins serving requests. Probe
            # the complete local gateway -> backend path before reporting ready.
            if curl -sf --noproxy '*' --max-time "$probe_timeout" \
                --unix-socket "$GATEWAY_SOCKET" \
                -H 'X-Trim-Userid: fn-seekbox-startup' \
                "http://localhost${GATEWAY_PREFIX}/api/health" >/dev/null 2>&1; then
                if check_pid "$gateway_pid" && check_pid "$backend_pid"; then
                    return 0
                fi
                return 2
            fi
        fi
        [ "$SECONDS" -lt "$deadline" ] && sleep 1
    done
    return 1
}

start_process() {
    if status; then
        log_msg "already running"
        return 0
    fi
    # 半残进程（只活了一个）先清掉再拉
    stop_process

    if [ ! -x "$BIN" ]; then
        echo "找不到后端程序: ${BIN}" > "${TRIM_TEMP_LOGFILE}"
        log_msg "ERROR: missing binary ${BIN}"
        return 1
    fi
    if [ ! -f "$GATEWAY" ]; then
        echo "找不到网关脚本: ${GATEWAY}" > "${TRIM_TEMP_LOGFILE}"
        log_msg "ERROR: missing gateway ${GATEWAY}"
        return 1
    fi

    mkdir -p "${TRIM_PKGVAR}/data/cache" \
             "${TRIM_PKGVAR}/data/logs/backend"

    export_runtime_env
    log_msg "starting backend PORT=${BACKEND_PORT} plugins=${ENABLED_PLUGINS}"

    cd "${TRIM_PKGVAR}/data" || return 1
    nohup "$BIN" >> "$BACKEND_LOG" 2>&1 &
    echo $! > "$BACKEND_PID_FILE"

    local i
    for i in $(seq 1 30); do
        if curl -sf --max-time 2 "http://${BACKEND_HOST}:${BACKEND_PORT}/api/health" >/dev/null 2>&1; then
            break
        fi
        if [ "$i" -eq 30 ]; then
            echo "后端启动超时，见 ${BACKEND_LOG}" > "${TRIM_TEMP_LOGFILE}"
            log_msg "ERROR: backend health timeout"
            stop_process
            return 1
        fi
        sleep 1
    done

    nohup python3 "$GATEWAY" >> "$GATEWAY_LOG" 2>&1 &
    echo $! > "$GATEWAY_PID_FILE"
    local gateway_pid backend_pid gateway_result
    gateway_pid=$(cat "$GATEWAY_PID_FILE")
    backend_pid=$(cat "$BACKEND_PID_FILE")
    wait_gateway_ready "$gateway_pid" "$backend_pid"
    gateway_result=$?
    if [ "$gateway_result" -ne 0 ]; then
        if [ "$gateway_result" -eq 2 ]; then
            echo "网关就绪前应用进程已退出，见 ${GATEWAY_LOG} 和 ${BACKEND_LOG}" > "${TRIM_TEMP_LOGFILE}"
            log_msg "ERROR: gateway or backend exited before gateway readiness"
        else
            echo "网关启动超时（30 秒），见 ${GATEWAY_LOG}" > "${TRIM_TEMP_LOGFILE}"
            log_msg "ERROR: gateway health timeout after 30 seconds"
        fi
        stop_process
        return 1
    fi
    log_msg "started gateway=unix:${GATEWAY_SOCKET} prefix=${GATEWAY_PREFIX}"
    return 0
}

stop_process() {
    local pid gateway_pid backend_pid
    gateway_pid=$(cat "$GATEWAY_PID_FILE" 2>/dev/null || true)
    backend_pid=$(cat "$BACKEND_PID_FILE" 2>/dev/null || true)
    for pid in "$gateway_pid" "$backend_pid"; do
        if check_pid "$pid"; then
            kill -TERM "$pid" 2>/dev/null || true
        fi
    done
    # The gateway usually exits first. Wait while either app process is alive
    # so the backend can finish cache writes and close its cloud journal.
    # Its cache shutdown budget is 10s plus the HTTP shutdown budget of 2s.
    local n=0
    while { check_pid "$gateway_pid" || check_pid "$backend_pid"; } && [ "$n" -lt 20 ]; do
        sleep 1
        n=$((n + 1))
    done
    for pid in "$gateway_pid" "$backend_pid"; do
        if check_pid "$pid"; then
            kill -KILL "$pid" 2>/dev/null || true
        fi
    done
    # Only the application-recorded PIDs are stopped. A port number alone
    # does not establish ownership of a process.
    [ -S "$GATEWAY_SOCKET" ] && rm -f "$GATEWAY_SOCKET"
    rm -f "$GATEWAY_PID_FILE" "$BACKEND_PID_FILE"
    log_msg "stopped"
    return 0
}

case "$1" in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    fi
    exit 3
    ;;
restart)
    stop_process
    start_process
    ;;
*)
    exit 1
    ;;
esac
